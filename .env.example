# Copie este arquivo para .env e preencha os valores.
# No Render, configure as mesmas variáveis em Environment.

# Chave para assinar os tokens de login. Gere uma com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token do Mercado Pago (painel de desenvolvedor > Credenciais)
MERCADO_PAGO_ACCESS_TOKEN=

# URL pública do site, sem barra no final (ex: https://goticket-l2y9.onrender.com)
BASE_URL=http://localhost:3000

# Caminho do banco SQLite. No Render, use um disco persistente (ex: /var/data/database.db)
DB_PATH=./database.db

PORT=3000
